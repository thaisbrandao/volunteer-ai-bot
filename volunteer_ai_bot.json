    {
      "parameters": {
        "functionCode": "const omdena = [];\nconst github = [];\nconst datakind = [];\n\nfor (const item of items) {\n  const { source, title, link } = item.json;\n\n  if (source === \"Omdena\") omdena.push({ title, link, source });\n  else if (source === \"GitHub\") github.push({ title, link, source });\n  else if (source === \"DataKind\") datakind.push({ title, link, source });\n}\n\nconst all = [...omdena, ...github, ...datakind];\n\n// Eliminar duplicados por link\nconst unique = [];\nconst seen = new Set();\n\nfor (const project of all) {\n  if (!seen.has(project.link)) {\n    seen.add(project.link);\n    unique.push(project);\n  }\n}\n\nreturn unique.map(project => ({ json: project }));"
      },
